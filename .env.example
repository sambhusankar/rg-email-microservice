REDIS_HOST=localhost
REDIS_PORT=6379

RESEND_API_KEY=
FROM_EMAIL=
# Optional, defaults to "RoomGrub". Shown as the sender display name.
FROM_NAME=

# Optional, defaults to "worker-1". Set a unique value per worker process
# if you ever run more than one consumer in the "email-workers" group.
CONSUMER_NAME=worker-1
